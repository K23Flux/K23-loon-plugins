#!name = NodeSeek 外链直跳
#!desc = 跳过 NodeSeek 的外链提醒页（/jump?to=...），直接打开目标地址
#!author = K23Flux
#!homepage = https://github.com/K23Flux/K23-loon-plugins
#!icon = https://www.nodeseek.com/static/image/favicon/android-chrome-192x192.png
#!loon_version = 3.5.1(978)

[Rewrite]
response if ${url} ~= /^https?:\/\/(www\.)?nodeseek\.com\/jump\?/ then response.body.mock("html", `<!DOCTYPE html><meta charset="utf-8"><meta name="referrer" content="no-referrer"><script>var t=new URLSearchParams(location.search).get("to");if(/^https?:/i.test(t)){location.replace(t)}else{document.write("无效的跳转地址")}</script>`, 200)

[MITM]
hostname = www.nodeseek.com
